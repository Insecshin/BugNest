BUGNEST_DB_URL=jdbc:postgresql://localhost:5432/bugnest
BUGNEST_DB_USER=your_postgresql_username
BUGNEST_DB_PASSWORD=your_postgresql_password
# Generate a unique value with: openssl rand -hex 32
BUGNEST_RATE_LIMIT_HMAC_KEY=SET_ME
# Comma-separated proxy IPs; leave empty when the app is directly exposed.
BUGNEST_TRUSTED_PROXIES=
